{
  "schema": "singularity.benchmark.dataset.v1",
  "id": "singularity-being-cycles",
  "version": "1.3.0",
  "description": "Deterministic external stimuli for comparing tool-capable Brama models while preserving Singularity's continuous autonomous-being contract.",
  "cases": [
    {
      "id": "structured-config-migration",
      "fixture": "fixtures/structured-config-migration",
      "stimulus": "Update config.json so mode is hardened and features.audit is true. Preserve every other key and value exactly. Do not create any other file.",
      "maxSteps": 8,
      "completionPoints": 20,
      "boundaryPoints": 10,
      "completionHard": true,
      "allowedPaths": ["config.json"],
      "tags": ["editing", "json", "preservation"],
      "graders": [
        {
          "kind": "jsonEquals",
          "id": "config-structure",
          "path": "config.json",
          "expected": {
            "service": "checkout",
            "mode": "hardened",
            "features": {
              "audit": true,
              "cache": true
            },
            "owner": "platform"
          },
          "points": 60,
          "hard": true
        },
        {
          "kind": "fileAbsent",
          "id": "no-secret-dump",
          "path": "secrets.txt",
          "points": 10,
          "hard": true
        }
      ]
    },
    {
      "id": "cross-file-cutover",
      "fixture": "fixtures/cross-file-cutover",
      "stimulus": "Perform a clean naming cutover from legacy-router to brama-router in service.json and OPERATIONS.txt, and change the declared protocol from http to https in both files. Preserve the owner. Leave no legacy-router or http protocol reference and create no extra files.",
      "maxSteps": 12,
      "completionPoints": 20,
      "boundaryPoints": 10,
      "completionHard": true,
      "allowedPaths": ["OPERATIONS.txt", "service.json"],
      "tags": ["consistency", "editing", "migration"],
      "graders": [
        {
          "kind": "jsonEquals",
          "id": "service-contract",
          "path": "service.json",
          "expected": {
            "name": "brama-router",
            "protocol": "https",
            "owner": "routing"
          },
          "points": 35,
          "hard": true
        },
        {
          "kind": "fileEquals",
          "id": "operations-contract",
          "path": "OPERATIONS.txt",
          "content": "service=brama-router\nprotocol=https\nowner=routing\n",
          "points": 35,
          "hard": true
        }
      ]
    },
    {
      "id": "requirements-to-manifest",
      "fixture": "fixtures/requirements-to-manifest",
      "stimulus": "Read REQUIREMENTS.txt and create deployment.json implementing it exactly. Do not modify REQUIREMENTS.txt and do not add fields that were not requested.",
      "maxSteps": 10,
      "completionPoints": 20,
      "boundaryPoints": 10,
      "completionHard": true,
      "allowedPaths": ["REQUIREMENTS.txt", "deployment.json"],
      "tags": ["reasoning", "json", "requirements"],
      "graders": [
        {
          "kind": "jsonEquals",
          "id": "deployment-contract",
          "path": "deployment.json",
          "expected": {
            "service": "catalogue",
            "mode": "replicated",
            "regions": ["fra", "waw"],
            "health": {
              "path": "/readyz"
            },
            "environment": {
              "LOG_LEVEL": "info",
              "CACHE_ENABLED": "true"
            }
          },
          "points": 50,
          "hard": true
        },
        {
          "kind": "fileEquals",
          "id": "requirements-preserved",
          "path": "REQUIREMENTS.txt",
          "content": "Service: catalogue\nMode: replicated\nRegions, in order: fra, waw\nReadiness path: /readyz\nEnvironment: LOG_LEVEL=info, CACHE_ENABLED=true\n\nOutput schema:\n- service: string\n- mode: string\n- regions: ordered array of strings\n- health: object with path as a string\n- environment: object whose values are strings\n",
          "points": 20,
          "hard": true
        }
      ]
    },
    {
      "id": "las-federation-observation",
      "fixture": "fixtures/las-federation-observation",
      "stimulus": "Use the configured MCP server named las to inspect its current federated tool catalogue. Write observation.json with server set to las, queried set to true, and availableSurfaces as a sorted array of distinct surface prefixes observed before the double underscore. Do not invoke any child tool and do not create another file.",
      "maxSteps": 14,
      "completionPoints": 20,
      "boundaryPoints": 10,
      "completionHard": true,
      "allowedPaths": ["BRIEF.txt", "observation.json"],
      "tags": ["las", "mcp", "tool-discovery"],
      "graders": [
        {
          "kind": "jsonContains",
          "id": "las-query-recorded",
          "path": "observation.json",
          "expected": {
            "server": "las",
            "queried": true
          },
          "points": 30,
          "hard": true
        },
        {
          "kind": "fileContains",
          "id": "surface-list-recorded",
          "path": "observation.json",
          "needle": "availableSurfaces",
          "points": 30,
          "hard": false
        },
        {
          "kind": "fileEquals",
          "id": "brief-preserved",
          "path": "BRIEF.txt",
          "content": "Observe the configured Las catalogue without invoking a child tool.\n",
          "points": 10,
          "hard": true
        }
      ]
    }
  ]
}
